// =============================================================================
//  firestore.rules  ·  Point Market — Clean Firestore Security Rules
//
//  HOW TO DEPLOY:
//  firebase deploy --only firestore:rules
// =============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthed()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).exists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function onlyUpdates(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthed();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.pmPoints == 100
        && request.resource.data.isAdmin == false;

      allow update: if (
          isOwner(uid)
          && onlyUpdates([
            "fullName", "username", "bio", "avatarEmoji", "email", "phone",
            "city", "lat", "lng", "lastActiveAt", "followers",
            "following", "likedListings", "updatedAt", "pointsStatus",
            "productListingCount", "skillListingCount",
            "sellerSuccessfulListings", "sellerAverageAiScore",
            "sellerFlaggedListings", "sellerBadge", "sellerBadgeLabel",
            "sellerBadgeAwardedAt"
          ])
          && request.resource.data.isAdmin == resource.data.isAdmin
          && !("isSuspended" in request.resource.data.diff(resource.data).affectedKeys())
        ) || isAdmin();

      allow delete: if isAdmin();

      match /posts/{postId} {
        allow read: if isAuthed();
        allow create: if isOwner(uid)
          && request.resource.data.userId == uid;
        allow update, delete: if isOwner(uid) || isAdmin();
      }

      match /saved_listings/{savedId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── POSTS ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthed()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── PRODUCT LISTINGS ────────────────────────────────────────────────────
    match /product_listings/{listingId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isRemoved == false
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.status in ["active", "draft"];

      allow update: if isAuthed() && (
        (resource.data.uid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["uid", "isRemoved", "removedBy", "isBoosted", "boostExpiresAt"]))
        || isAdmin()
      );

      allow delete: if false;

      match /listing_reviews/{reviewId} {
        allow read:   if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if isAdmin();
      }
    }

    // ── SKILL LISTINGS ──────────────────────────────────────────────────────
    match /skill_listings/{listingId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isRemoved == false
        && request.resource.data.title.size() >= 3
        && request.resource.data.status in ["active", "draft"];

      allow update: if isAuthed() && (
        (resource.data.uid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["uid", "isRemoved", "removedBy", "isBoosted", "boostExpiresAt"]))
        || isAdmin()
      );

      allow delete: if false;

      match /listing_reviews/{reviewId} {
        allow read:   if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if isAdmin();
      }
    }

    // ── CATEGORIES ─────────────────────────────────────────────────────────
    match /categories/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── TRADES ─────────────────────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read: if (isAuthed()
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid)
      ) || isAdmin();

      allow create: if isAuthed()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if isAuthed() && (
        (resource.data.toUid == request.auth.uid
          && onlyUpdates(["status", "updatedAt"]))
        || (resource.data.fromUid == request.auth.uid
          && request.resource.data.status == "cancelled")
      ) || isAdmin();
    }

    // ── POINTS LEDGER ──────────────────────────────────────────────────────
    match /points_ledger/{ledgerId} {
      allow read: if (isAuthed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    // ── POINTS REWARDS ─────────────────────────────────────────────────────
    match /points_rewards/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── POINTS TRANSFERS ───────────────────────────────────────────────────
    match /points_transfers/{transferId} {
      allow read: if (isAuthed()
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid)
      ) || isAdmin();

      allow create: if isAuthed()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 5000
        && request.resource.data.status == "completed";

      allow update, delete: if isAdmin();
    }

    // ── POINTS FRAUD LOG ───────────────────────────────────────────────────
    match /points_fraud_log/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // ── REVIEWS ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.reviewerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── REPORTS ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if (isAuthed() && resource.data.reporterUid == request.auth.uid) || isAdmin();
      allow create: if isAuthed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── LISTING REPORTS ────────────────────────────────────────────────────
    match /listing_reports/{reportId} {
      allow read: if (isAuthed() && resource.data.reporterUid == request.auth.uid) || isAdmin();
      allow create: if isAuthed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── SEARCH INDEX ───────────────────────────────────────────────────────
    match /search_index/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── DEVICE FINGERPRINTS ─────────────────────────────────────────────────
    match /device_fingerprints/{fpHash} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
